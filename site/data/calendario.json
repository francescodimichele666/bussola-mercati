{"aggiornato":"2026-10-30","automatico":true,"fonte":"Eurostat, Istat, Banca Centrale Europea, Federal Reserve, Bureau of Labor Statistics e Bureau of Economic Analysis","fonti":{"Eurostat":"https://ec.europa.eu/eurostat/news/euro-indicators/release-calendar","Istat":"https://www.istat.it/attivita-e-servizi-per-tipo-di-utenti/giornalisti/appuntamenti/calendario-delle-diffusioni-e-degli-eventi/","BCE":"https://www.ecb.europa.eu/press/calendars/mgcgc/html/index.en.html","Fed":"https://www.federalreserve.gov/monetarypolicy/fomccalendars.htm","BLS":"https://www.bls.gov/schedule/news_release/","BEA":"https://www.bea.gov/news/schedule"},"paesi":{"IT":"Italia","EU":"Area euro","US":"Stati Uniti"},"famiglie":{"inflazione":{"nome":"Inflazione","cosa":"Di quanto sono saliti i prezzi al consumo, rispetto a un anno prima o al mese prima.","lettura":"Se esce più alta delle attese, di solito il mercato pensa che la banca centrale terrà i tassi alti più a lungo: i rendimenti dei titoli di Stato tendono a salire, le obbligazioni già in circolazione perdono un po' di valore e le borse possono soffrire. Un dato più basso delle attese in genere ha l'effetto opposto."},"inflazione_core":{"nome":"Inflazione di fondo","cosa":"L'inflazione senza energia e alimentari freschi, i prezzi che cambiano di più da un mese all'altro. Mostra la tendenza di fondo.","lettura":"Le banche centrali la guardano con molta attenzione. Una sorpresa al rialzo di solito spinge su i rendimenti e rafforza la valuta; una sorpresa al ribasso tende a fare il contrario."},"prezzi_imprese":{"nome":"Prezzi alla produzione","cosa":"I prezzi che le imprese pagano o praticano tra loro, prima che i beni arrivino al consumatore.","lettura":"Spesso anticipano di qualche mese i prezzi al consumo. Di solito muovono il mercato meno dell'inflazione, ma una sorpresa ampia può far salire o scendere i rendimenti."},"banca_centrale":{"nome":"Banca centrale","cosa":"La decisione sul costo del denaro, il comunicato che la spiega e la conferenza stampa che segue.","lettura":"Il mercato si muove soprattutto se la decisione è diversa da quella attesa. Se è in linea, conta di più cosa viene detto sulle prossime mosse. Tassi più alti di solito rafforzano la valuta e pesano su obbligazioni e borse; tassi più bassi tendono a fare il contrario."},"discorso":{"nome":"Discorso","cosa":"Un intervento pubblico di un membro della banca centrale.","lettura":"Non ci sono numeri, ma le parole possono cambiare le attese sui tassi futuri. Per questo a volte muovono valuta e rendimenti, soprattutto se chi parla è il presidente."},"pil":{"nome":"Crescita dell'economia","cosa":"Quanto è cresciuto il prodotto interno lordo, cioè il valore di tutto ciò che il Paese produce.","lettura":"Una crescita più forte delle attese di solito sostiene le borse, ma può far salire i rendimenti. Un dato debole tende a fare l'opposto e aumenta i timori di recessione. La prima stima viene spesso corretta nei mesi successivi."},"stima_pil":{"nome":"Stima in tempo reale","cosa":"La stima della crescita americana calcolata dalla Fed di Atlanta con i dati man mano disponibili. Non è il dato ufficiale.","lettura":"Si aggiorna più volte al mese. Di solito ha un effetto limitato sui mercati, ma aiuta a capire che cosa aspettarsi dal dato ufficiale."},"lavoro":{"nome":"Lavoro","cosa":"Quante persone lavorano, quante cercano lavoro, quanti posti si creano.","lettura":"Un mercato del lavoro forte di solito significa più consumi, ma anche più pressione su salari e prezzi. Negli Stati Uniti il dato mensile sugli occupati (Non Farm Payrolls) è tra i più seguiti al mondo e può muovere molto dollaro, titoli di Stato e borse."},"salari":{"nome":"Salari e costo del lavoro","cosa":"Quanto crescono le paghe e il costo del lavoro per le imprese.","lettura":"Salari che crescono in fretta possono alimentare l'inflazione. Per questo una sorpresa al rialzo di solito fa salire i rendimenti."},"fiducia":{"nome":"Fiducia","cosa":"Sondaggi che chiedono a famiglie o imprese come vedono la situazione e i prossimi mesi.","lettura":"Anticipano i comportamenti di spesa e di investimento. In genere l'effetto sul mercato è limitato, salvo sorprese ampie."},"pmi":{"nome":"Indice dei direttori acquisti","cosa":"Un sondaggio tra i responsabili acquisti delle aziende. Sopra 50 indica attività in crescita, sotto 50 in calo.","lettura":"È tra i primi dati disponibili di ogni mese e per questo è molto seguito. Un dato sopra le attese di solito sostiene le borse e la valuta del Paese."},"attivita_regionale":{"nome":"Attività regionale","cosa":"Indici sull'attività economica in una singola zona degli Stati Uniti. Lo zero indica la media.","lettura":"Di solito hanno un effetto modesto: servono come anticipo dei dati nazionali."},"produzione":{"nome":"Produzione e ordini","cosa":"Quanto producono le fabbriche e quanti ordini ricevono.","lettura":"Dati più forti delle attese indicano un'industria in salute e in genere sostengono le borse. L'effetto è di solito moderato."},"consumi":{"nome":"Consumi e redditi","cosa":"Quanto spendono e quanto guadagnano le famiglie.","lettura":"I consumi sono la parte più grande dell'economia. Una spesa più forte delle attese di solito sostiene le borse, ma può far salire i rendimenti."},"casa":{"nome":"Casa","cosa":"Compravendite, permessi di costruzione, prezzi delle case e tassi sui mutui.","lettura":"Il settore immobiliare reagisce presto ai tassi d'interesse. Di solito l'effetto sui mercati è modesto, salvo variazioni ampie."},"commercio":{"nome":"Commercio estero","cosa":"Differenza tra quanto un Paese vende all'estero e quanto compra.","lettura":"In genere ha poco effetto sulle borse; può influire sulla valuta del Paese."},"energia":{"nome":"Petrolio","cosa":"Variazione settimanale delle scorte di greggio e benzina negli Stati Uniti, o stime sul mercato dell'energia.","lettura":"Scorte in calo più delle attese di solito spingono in su il prezzo del petrolio, e viceversa. Conta per l'inflazione e per le società energetiche."},"conti_pubblici":{"nome":"Conti pubblici","cosa":"Il saldo tra entrate e spese dello Stato nel mese.","lettura":"Deficit più ampi significano più titoli di Stato da emettere. Di solito l'effetto immediato è piccolo."},"politica":{"nome":"Politica","cosa":"Un appuntamento politico, come un'elezione.","lettura":"Può portare oscillazioni perché cambia le attese su tasse, spesa pubblica e regole. L'effetto dipende dal risultato e da quanto era atteso."}},"eventi":[{"data":"2026-10-28T10:00:00Z","paese":"IT","nome":"Prezzi alla produzione","originale":"Prezzi alla produzione dell’industria e delle costruzioni | Settembre 2026","fase":null,"famiglia":"prezzi_imprese","importanza":"normale","periodo":"settembre 2026","effettivo":null,"previsto":null,"precedente":null,"unita":null,"scala":null,"fonte":"Istat","fonte_url":"https://www.istat.it/attivita-e-servizi-per-tipo-di-utenti/giornalisti/appuntamenti/calendario-delle-diffusioni-e-degli-eventi/","ultimo":null},{"data":"2026-10-28T18:00:00Z","paese":"US","nome":"Decisione sui tassi della Fed","originale":"FOMC October 27-28","fase":null,"famiglia":"banca_centrale","importanza":"alta","periodo":null,"effettivo":null,"previsto":null,"precedente":null,"unita":null,"scala":null,"fonte":"Fed","fonte_url":"https://www.federalreserve.gov/monetarypolicy/fomccalendars.htm","ultimo":{"valore":4.0,"periodo":"2026-10-30","nome":"Tasso Fed (limite superiore)","unita":"%","fonte":"FRED, St. Louis Fed"}},{"data":"2026-10-29T09:00:00Z","paese":"IT","nome":"Occupati e disoccupati","originale":"Occupati e disoccupati (stima provvisoria) | Settembre 2026","fase":null,"famiglia":"lavoro","importanza":"alta","periodo":"settembre 2026","effettivo":null,"previsto":null,"precedente":null,"unita":null,"scala":null,"fonte":"Istat","fonte_url":"https://www.istat.it/attivita-e-servizi-per-tipo-di-utenti/giornalisti/appuntamenti/calendario-delle-diffusioni-e-degli-eventi/","ultimo":{"valore":6.3,"periodo":"2026-09","nome":"D